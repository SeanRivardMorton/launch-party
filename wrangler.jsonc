{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launch-party",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "launchparty.thunkoid.com", "custom_domain": true }],
  "vars": {
    "BETTER_AUTH_URL": "https://launchparty.thunkoid.com"
  },
  "durable_objects": { "bindings": [
    { "name": "GUILD_CAMPFIRES", "class_name": "GuildCampfire" },
    { "name": "AVATAR_JOBS", "class_name": "AvatarGeneration" }
  ] },
  "migrations": [{ "tag": "campfire-v1", "new_sqlite_classes": ["GuildCampfire", "AvatarGeneration"] }],
  "r2_buckets": [{ "binding": "AVATAR_BUCKET", "bucket_name": "launch-party-avatars" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "launch-party",
      "database_id": "d791ce27-a095-490a-96f4-93ee74c5f9a3",
      "migrations_dir": "migrations"
    }
  ]
}
